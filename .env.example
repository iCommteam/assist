# Local development uses fixed defaults for the two secrets and the URL.
# Production requires all three; generate each secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# `pnpm dev` overrides both with the local Docker Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
# Base64-encoded 32-byte vault key.
SECRET_ENCRYPTION_KEY=
# Required for browser execution. Create a key at https://kernel.sh.
KERNEL_API_KEY=
# Required for model inference: both agents call Anthropic directly.
ANTHROPIC_API_KEY=
# Team sign-in: email, password and an authenticator app. Unset means nobody
# can sign up or stay signed in. Lists are comma-separated and case-insensitive.
ASSIST_ALLOWED_EMAILS=
ASSIST_ADMIN_EMAILS=
# Shared code every new account must enter; at least 16 characters.
ASSIST_SIGNUP_CODE=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
